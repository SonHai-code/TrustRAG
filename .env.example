# Copy to .env  (cp .env.example .env). NEVER commit .env
POSTGRES_USER=trustrag
POSTGRES_PASSWORD=trustrag_dev
POSTGRES_DB=trustrag
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=legal_docs
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ---- Phase 2: LLM + API ----
# provider: anthropic | openai (any OpenAI-compatible server) | mock (offline, no key needed)
LLM_PROVIDER=anthropic
LLM_API_KEY=
# empty = sensible default per provider (anthropic: claude-sonnet-5-5, openai: gpt-4o-mini)
LLM_MODEL=
# only for openai-compatible servers, e.g. http://localhost:8001/v1 (vLLM, Phase 6)
LLM_BASE_URL=
TOP_K=5
# below this retrieval score the API refuses to answer (tune it with scripts/baseline.py)
MIN_SCORE=0.35
WARMUP=true
